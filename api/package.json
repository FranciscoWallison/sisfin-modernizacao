{
  "name": "sisfin-api",
  "version": "0.1.0",
  "private": true,
  "description": "SisFin reescrito (TO-BE) — NestJS + Prisma + PostgreSQL",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "arquitetura": "depcruise src --config .dependency-cruiser.cjs --output-type err-long",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "jsonwebtoken": "9.0.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "stripe": "22.6.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.2.6",
    "@types/express": "5.0.6",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.4",
    "@types/supertest": "6.0.3",
    "dependency-cruiser": "18.4.0",
    "jest": "29.7.0",
    "prisma": "6.19.3",
    "supertest": "7.3.0",
    "ts-jest": "29.4.13",
    "typescript": "5.9.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/test"
    ],
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$"
  }
}
