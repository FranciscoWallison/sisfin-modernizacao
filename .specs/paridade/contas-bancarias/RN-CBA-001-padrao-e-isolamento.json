  "descricao": "Criar/editar conta bancária; no máximo UMA padrão por cliente (marcar uma desmarca a anterior; desmarcar deixa nenhuma); outro cliente não lê, não edita nem exclui. Listas em ordem de id DECRESCENTE: com o acúmulo de rodadas o cliente passa de 100 contas, e a recém-criada precisa estar na página.",
  "usuarios": {
    "padrao": {
      "email": "cliente1@user.com",
      "password": "secret"
    },
    "outro_cliente": {
      "email": "cliente3@user.com",
      "password": "secret"
    }
  },
  "passos": [
    {
      "nome": "padroes_de_b_antes",
      "usuario": "outro_cliente",
