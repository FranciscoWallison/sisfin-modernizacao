  "derivar": {
    "formato_do_mes": "d.period_list.every(p => /^\\d{4}-\\d{2}$/.test(p.period))",
    "primeiro_mes_receitas_delta": "((l, p) => l.find(x => x.period === p)?.revenues.total ?? 0)(d.period_list, '2018-01') - ((l, p) => l.find(x => x.period === p)?.revenues.total ?? 0)(a.period_list, '2018-01')",
    "marco_despesas_delta": "((l, p) => l.find(x => x.period === p)?.expenses.total ?? 0)(d.period_list, '2018-03') - ((l, p) => l.find(x => x.period === p)?.expenses.total ?? 0)(a.period_list, '2018-03')",
    "dezembro_receitas_delta": "((l, p) => l.find(x => x.period === p)?.revenues.total ?? 0)(d.period_list, '2018-12') - ((l, p) => l.find(x => x.period === p)?.revenues.total ?? 0)(a.period_list, '2018-12')",
    "janeiro_2019_fora_da_janela": "!d.period_list.some(p => p.period === '2019-01')",
    "raiz_despesa_marco_delta": "((c, id, p) => c.find(x => x.id === id)?.periods.filter(y => y.period === p).reduce((s, y) => s + Number(y.total), 0) ?? 0)(d.categories_period.expenses.data, raiz_despesa, '2018-03') - ((c, id, p) => c.find(x => x.id === id)?.periods.filter(y => y.period === p).reduce((s, y) => s + Number(y.total), 0) ?? 0)(a.categories_period.expenses.data, raiz_despesa, '2018-03')",
    "categoria_filha_nao_aparece_sozinha": "!d.categories_period.expenses.data.some(x => x.id === filha_despesa)",
    "saldo_antes_do_primeiro_mes_inalterado": "d.balance_before_first_month === a.balance_before_first_month",
    "outro_cliente_nao_ve_nada": "JSON.stringify(outro_depois) === JSON.stringify(outro_antes)"
  },
