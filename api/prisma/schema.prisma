// Schema do SisFin reescrito (T03). Nomes de tabela e coluna IGUAIS ao legado (@@map/@map)
// para que o ETL (tools/migrar-dados.mjs) seja cópia direta. Decisões: design.md §3, ADR-003.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Client {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  email     String    @db.VarChar(255)
  code      String?   @db.VarChar(255)
  /// Cliente no Stripe (ADR-011). O `code` é o id antigo na Iugu e fica como veio do legado.
  stripeCustomerId String? @unique @map("stripe_customer_id") @db.VarChar(255)
  /// Sessão de checkout ainda aberta: reaproveitada para o cliente não abrir duas e pagar duas vezes (ADR-011)
  checkoutSessionId        String?   @map("checkout_session_id") @db.VarChar(255)
  checkoutSessionUrl       String?   @map("checkout_session_url") @db.VarChar(2048)
  checkoutSessionExpiresAt DateTime? @map("checkout_session_expires_at") @db.Timestamp(0)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  subscriptions     Subscription[]
  users             User[]
  bankAccounts      BankAccount[]
  categoryExpenses  CategoryExpense[]
  categoryRevenues  CategoryRevenue[]
  billPays          BillPay[]
  billReceives      BillReceive[]
  statements        Statement[]

  @@map("clients")
}

model User {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(255)
  email         String    @unique @db.VarChar(255)
  password      String    @db.VarChar(255)
  rememberToken String?   @map("remember_token") @db.VarChar(100)
  role          String    @default("client") @db.VarChar(255)
  clientId      Int?      @map("client_id")
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)

  client     Client?     @relation(fields: [clientId], references: [id])
  statements Statement[]

  @@map("users")
}

model Bank {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  logo      String    @db.VarChar(255)
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  bankAccounts BankAccount[]

  @@map("banks")
}

model BankAccount {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  agency    String?   @db.VarChar(255)
  account   String?   @db.VarChar(255)
  default   Boolean   @default(false)
  balance   Decimal   @default(0) @db.Decimal(12, 2) // legado: DOUBLE(8,2) — RN-CON-011
  bankId    Int       @map("bank_id")
  clientId  Int       @map("client_id")
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  bank         Bank          @relation(fields: [bankId], references: [id])
  client       Client        @relation(fields: [clientId], references: [id])
  billPays     BillPay[]
  billReceives BillReceive[]
  statements   Statement[]

  @@index([clientId])
  @@map("bank_accounts")
}

// Árvore de categorias em nested set (kalnoy/nestedset no legado): _lft/_rgt preservados pelo ETL
model CategoryExpense {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  lft       Int       @map("_lft")
  rgt       Int       @map("_rgt")
  parentId  Int?      @map("parent_id")
  clientId  Int       @map("client_id")
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  client   Client    @relation(fields: [clientId], references: [id])
  billPays BillPay[]

  @@index([clientId])
  @@index([lft, rgt, parentId])
  @@map("category_expenses")
}

model CategoryRevenue {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(255)
  lft       Int       @map("_lft")
  rgt       Int       @map("_rgt")
  parentId  Int?      @map("parent_id")
  clientId  Int       @map("client_id")
  createdAt DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt DateTime? @map("updated_at") @db.Timestamp(0)

  client       Client        @relation(fields: [clientId], references: [id])
  billReceives BillReceive[]

  @@index([clientId])
  @@index([lft, rgt, parentId])
  @@map("category_revenues")
}

model BillPay {
  id            Int       @id @default(autoincrement())
  dateDue       DateTime  @map("date_due") @db.Date
  name          String    @db.VarChar(255)
  value         Decimal   @db.Decimal(12, 2) // legado: DOUBLE(8,2) — RN-CON-011
  done          Boolean   @default(false) // legado: sem default (->defalt) — RN-CON-012 / REQ-CON-10
  clientId      Int       @map("client_id")
  categoryId    Int       @map("category_id") // FK para category_EXPENSES (revisão de segurança #6)
  bankAccountId Int       @map("bank_account_id")
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)

  client      Client          @relation(fields: [clientId], references: [id])
  category    CategoryExpense @relation(fields: [categoryId], references: [id])
  bankAccount BankAccount     @relation(fields: [bankAccountId], references: [id])

  @@index([clientId, dateDue])
  @@map("bill_pays")
}

model BillReceive {
  id            Int       @id @default(autoincrement())
  dateDue       DateTime  @map("date_due") @db.Date
  name          String    @db.VarChar(255)
  value         Decimal   @db.Decimal(12, 2)
  done          Boolean   @default(false)
  clientId      Int       @map("client_id")
  categoryId    Int       @map("category_id") // FK para category_REVENUES
  bankAccountId Int       @map("bank_account_id")
  createdAt     DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt     DateTime? @map("updated_at") @db.Timestamp(0)

  client      Client          @relation(fields: [clientId], references: [id])
  category    CategoryRevenue @relation(fields: [categoryId], references: [id])
  bankAccount BankAccount     @relation(fields: [bankAccountId], references: [id])

  @@index([clientId, dateDue])
  @@map("bill_receives")
}

// Extrato. Polimórfico como no legado (statementable_type/id), sem FK para a conta de origem:
// o histórico sobrevive à exclusão da conta (REQ-CON-09).
model Statement {
  id                Int       @id @default(autoincrement())
  value             Decimal   @db.Decimal(12, 2)
  balance           Decimal   @db.Decimal(12, 2)
  bankAccountId     Int       @map("bank_account_id")
  clientId          Int       @map("client_id")
  statementableId   Int       @map("statementable_id")
  statementableType String    @map("statementable_type") @db.VarChar(255) // "BillPay" | "BillReceive"
  kind              String    @default("movimento") @db.VarChar(20) // movimento | estorno (REQ-CON-09)
  userId            Int?      @map("user_id") // auditoria (REQ-CON-13); nulo nos registros migrados
  action            String?   @db.VarChar(20) // criacao | pagamento | alteracao | estorno | exclusao
  createdAt         DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt         DateTime? @map("updated_at") @db.Timestamp(0)

  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])
  client      Client      @relation(fields: [clientId], references: [id])
  user        User?       @relation(fields: [userId], references: [id])

  // saldo anterior do fluxo de caixa: último extrato por conta antes de uma data (revisão de segurança do módulo)
  @@index([clientId, bankAccountId, createdAt, id])
  @@index([statementableType, statementableId])
  @@map("statements")
}

// Assinaturas (ADR-011, design de assinaturas §1). O preço de verdade mora no Stripe; `plans` é o que a tela mostra.
model Plan {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(255)
  description String    @db.VarChar(255)
  value       Decimal   @db.Decimal(12, 2)
  createdAt   DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime? @map("updated_at") @db.Timestamp(0)

  subscriptions Subscription[]

  @@map("plans")
}

/// Assinatura do CLIENTE (tenant). No máximo uma viva por cliente: índice único parcial na migration (DUV-ASS-005).
/// `incomplete` (3DS abandonado) não conta como viva: o cliente pode tentar pagar de novo (revisão A07, S8).
model Subscription {
  id                     Int       @id @default(autoincrement())
  clientId               Int       @map("client_id")
  planId                 Int?      @map("plan_id")
  providerSubscriptionId String    @unique @map("provider_subscription_id") @db.VarChar(255)
  /// Status do Stripe: active, trialing, past_due, canceled, unpaid, incomplete, incomplete_expired, paused
  status                 String    @db.VarChar(30)
  currentPeriodEnd       DateTime? @map("current_period_end") @db.Timestamp(0)
  cancelAtPeriodEnd      Boolean   @default(false) @map("cancel_at_period_end")
  canceledAt             DateTime? @map("canceled_at") @db.Timestamp(0)
  /// Instante (do Stripe) do último evento aplicado: evento mais antigo que chega depois é ignorado (ordem não garantida)
  lastEventAt            DateTime? @map("last_event_at") @db.Timestamp(0)
  createdAt              DateTime? @map("created_at") @db.Timestamp(0)
  updatedAt              DateTime? @map("updated_at") @db.Timestamp(0)

  client Client @relation(fields: [clientId], references: [id])
  plan   Plan?  @relation(fields: [planId], references: [id])

  @@map("subscriptions")
}

/// Eventos do webhook já processados: idempotência pelo id do evento (REQ-ASS-03).
model WebhookEvent {
  id         String   @id @db.VarChar(255)
  type       String   @db.VarChar(100)
  receivedAt DateTime @map("received_at") @db.Timestamp(0)

  @@map("webhook_events")
}
