        "name": "INVADIDA",
        "agency": "9",
        "account": "9",
        "bank_id": 1,
        "default": true
      }
    },
    {
      "nome": "b_exclui",
      "usuario": "outro_cliente",
      "metodo": "DELETE",
      "rota": "/api/bank_accounts/{{c1}}"
