      "registrar": false
    }
  ],
  "derivar": {
    "uma_padrao_apos_criar": "l1.filter(c => c.default).map(c => c.id).join() === String(c1)",
    "padrao_troca_para_a_segunda": "l2.filter(c => c.default).map(c => c.id).join() === String(c2)",
    "nenhuma_padrao_apos_desmarcar": "l3.filter(c => c.default).length === 0",
    "padroes_de_b_intactos": "JSON.stringify(b_antes.filter(c => c.default).map(c => c.id)) === JSON.stringify(b_depois.filter(c => c.default).map(c => c.id))"
