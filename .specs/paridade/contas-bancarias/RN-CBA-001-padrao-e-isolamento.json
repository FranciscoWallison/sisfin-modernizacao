    },
    {
      "nome": "desmarcar_a_segunda",
      "metodo": "PUT",
      "rota": "/api/bank_accounts/{{c2}}",
      "corpo": {
        "name": "PAR-CBA1b-{{execucao}}",
        "agency": "1",
        "account": "2",
        "bank_id": 2,
        "default": false
      },
      "caminho": "data",
      "campos": [
        "default"
      ]
    },
    {
      "nome": "lista_3",
      "rota": "/api/bank_accounts?orderBy=id&sortedBy=desc&limit=100",
      "salvar": {
        "l3": "data"
      },
      "registrar": false
