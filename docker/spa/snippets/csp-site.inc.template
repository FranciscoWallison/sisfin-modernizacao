# CSP do site novo (Vue 3 compilado: sem inline, sem eval). connect-src: só a API. frame-ancestors: sem iframe
# (clickjacking no login/cadastro). ${API_ORIGEM} vem do compose.
add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ${API_ORIGEM}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'" always;
